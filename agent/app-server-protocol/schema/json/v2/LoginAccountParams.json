            "null"
          ]
        },
        "type": {
          "enum": [
            "apiKey"
          ],
          "title": "ApiKeyv2::LoginAccountParamsType",
          "type": "string"
        }
      },
      "required": [
        "apiKey",
        "type"
      ],
      "title": "ApiKeyv2::LoginAccountParams",
      "type": "object"
    },
    {
